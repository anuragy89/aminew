{
    "name": "xBitMuisc",
    "description": "A Telegram Music Player Bot, written in Python with Pyrogram and Py-Tgcalls.",
    "logo": "https://imgur.com/a/zdIwpug",
    "keywords": [
    "python3",
    "telegram",
    "bot",
    "AnonX",
    "MusicBot",
    "telegram-bot",
    "pyrogram"
    ],
    "env": {
      "API_ID": {
        "description": "Get this value from https://my.telegram.org",
        "value": "",
        "required": true
      },
      "API_HASH": {
        "description": "Get this value from https://my.telegram.org",
        "value": "",
        "required": true
      },
      "ASSISTANT_LEAVE_TIME": {
        "description": "Time after which assistant leaves the group after the music is over. Default is 600 seconds. Set 0 to disable.",
        "value": "172800",
        "required": false
      },
      "AUTO_LEAVING_ASSISTANT": {
        "description": "Enable or disable auto leaving assistant after the music is over. True/False",
        "value": "True",
        "required": false
      },
      "BOT_TOKEN": {
        "description": "A Bot's token from Botfather",
        "value": "",
        "required": true
      },
      "GIT_TOKEN": {
        "description": "Your GitHub Personal Access Token. Generate one from https://github.com/settings/tokens.",
        "value": "",
        "required": false
      },
      "LOGGER_ID": {
        "description": "Your Log Group ID, add your bot and promote as an admin with full rights!. Channel ki id mat daal dena bsdk.",
        "value": "",
        "required": true
      },
      "MONGO_DB_NAME": {
        "description": "Mongo db name for your bot.",
        "value": "Stranger",
        "required": false
      },
      "MONGO_DB_URI": {
        "description": "Get a mongodb url from https://cloud.mongodb.com.",
        "value": "",
        "required": true
      },
      "OWNER_ID": {
        "description": "The user id of user whom you would like to add as OWNER.",
        "value": "",
        "required": true
      },
      "STRING_SESSION": {
        "description": "A Pyrogram v2 String Session from @StringFatherBot on Telegram.",
        "value": "",
        "required": true
      },
      "SUPPORT_CHANNEL": {
        "description": "Your Bot's Support Channel Username (with @).",
        "value": "",
        "required": false
      },
      "SUPPORT_CHAT": {
        "description": "Your Bot's Support Group Username (with @).",
        "value": "",
        "required": false
      },
      "UPSTREAM_REPO": {
        "description": "The repository URL of the bot you forked from. Don't change unless you know what you are doing.",
        "value": "",
        "required": false
      },
      "YTPROXY_URL": {
        "description": "YT Proxy Server Endpoint",
        "value": "https://tgapi.xbitcode.com",
        "required": true
      },
        "YT_API_KEY": {
        "description": "YT Proxy API KEY",
        "value": "",
        "required": true
      },
      "HEROKU_API_KEY": {
        "description": "Your Heroku account's API key",
        "value": "",
        "required": false
      },
      "HEROKU_APP_NAME": {
        "description": "Your heroku app name",
        "value": "",
        "required": false
      }
      
    },
    "buildpacks": [
          {
              "url": "heroku/python"
          },
          {
              "url": "heroku/nodejs"
          },
          {
              "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"
          }
      ],
      "stack": "container"
}
