rm -f logs.txt log.txt
rm -rf __pycache__
rm -f *.session
echo "Disabling IPV6"
sysctl -w net.ipv6.conf.all.disable_ipv6=1 &
sysctl -w net.ipv6.conf.default.disable_ipv6=1 &
sysctl -w net.ipv6.conf.lo.disable_ipv6=1 & 
sleep 2

# Load BOT_ID from .env if exists
if [ -f ".env" ]; then
    export $(grep -E '^BOT_ID=' .env | xargs)
fi

# Write PID file for bot manager (VPS deployments)
if [ -n "$BOT_ID" ] && [ -d "/var/lib/bot-manager/pids" ]; then
    echo "Writing PID file for bot manager..."
    # Start bot in background, capture PID, then wait
    uv run python -m AnonXMusic &
    BOT_PID=$!
    echo $BOT_PID > "/var/lib/bot-manager/pids/$BOT_ID.pid"
    echo "Bot started with PID: $BOT_PID"
    # Wait for the bot process
    wait $BOT_PID
    # Clean up PID file on exit
    rm -f "/var/lib/bot-manager/pids/$BOT_ID.pid"
else
    echo "Starting Bot..."
    uv run python -m AnonXMusic
fi
